--- /dev/null
+++ b/src/render/jv-index-upload-plan.ts
@@ -0,0 +1,28 @@
+import type { JvIndexedMesh } from "../scene/jv-world-contract.js";
+
+export type JvIndexUploadPlan =
+  | "UINT16_DIRECT"
+  | "UINT32_DIRECT"
+  | "UINT16_CHUNKED";
+
+const UINT16_VERTEX_CAPACITY = 65_536;
+
+export function selectJvIndexUploadPlan(
+  mesh: JvIndexedMesh,
+  uint32ElementIndicesSupported: boolean,
+): JvIndexUploadPlan {
+  if (mesh.positions.length === 0 || mesh.positions.length % 3 !== 0) {
+    throw new Error("JV index upload requires complete vec3 positions.");
+  }
+  if (mesh.indices.length === 0 || mesh.indices.length % 3 !== 0) {
+    throw new Error("JV index upload requires complete triangle indices.");
+  }
+  if (mesh.normals === undefined || !uint32ElementIndicesSupported) {
+    return "UINT16_CHUNKED";
+  }
+
+  const vertexCount = mesh.positions.length / 3;
+  return vertexCount <= UINT16_VERTEX_CAPACITY
+    ? "UINT16_DIRECT"
+    : "UINT32_DIRECT";
+}
