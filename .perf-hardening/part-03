+
+function mesh(vertexCount, indices, normals = true) {
+  return {
+    positions: new Float32Array(vertexCount * 3),
+    indices: new Uint32Array(indices),
+    ...(normals ? { normals: new Float32Array(vertexCount * 3) } : {}),
+    color: [1, 1, 1, 1],
+  };
+}
+
+test("scan upload uses the narrowest direct index type without rescanning indices", () => {
+  assert.equal(
+    selectJvIndexUploadPlan(mesh(65_536, [0, 65_535, 1]), true),
+    "UINT16_DIRECT",
+  );
+  assert.equal(
+    selectJvIndexUploadPlan(mesh(65_537, [0, 65_536, 1]), true),
+    "UINT32_DIRECT",
+  );
+});
+
+test("missing Uint32 support or generated normals preserve the legacy chunk fallback", () => {
+  assert.equal(
+    selectJvIndexUploadPlan(mesh(70_000, [0, 69_999, 1]), false),
+    "UINT16_CHUNKED",
+  );
