{
  "name": "jv-box3d-web-clean-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node tools/run-tests.mjs",
    "check:docs": "node tools/check-doc-links.mjs",
    "check:third-party": "node tools/verify-third-party-notices.mjs",
    "check:portable": "node tools/validate-portable-build.mjs",
    "audit:public": "node tools/audit-public-readiness.mjs",
    "check": "npm run typecheck && npm run test && npm run check:third-party",
    "build:bundle": "vite build",
    "build:portable": "npm run build:bundle && node tools/write-portable-build-manifest.mjs && npm run check:portable",
    "build": "npm run check && npm run build:portable",
    "preview": "vite preview"
  },
  "dependencies": {
    "box3d.js": "0.0.2"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}