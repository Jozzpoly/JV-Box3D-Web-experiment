{
  "name": "jv-box3d-web-experiment",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-assets": "node tools/sync-jv-assets.mjs",
    "verify-runtime": "node tools/check-box3d-runtime.mjs",
    "predev": "npm run sync-assets && npm run verify-runtime",
    "dev": "vite",
    "prebuild": "npm run sync-assets",
    "build": "npm run typecheck && npm run verify-runtime && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "box3d.js": "0.0.2",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "0.185.1",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
